# --- Database (required) ---
# Must use the asyncpg driver (bare postgresql:// fails: psycopg2 is not installed).
# Local docker compose: postgresql+asyncpg://sande:sande@localhost:5432/postgres
DATABASE_URL=postgresql+asyncpg://sande:sande@localhost:5432/postgres

# --- Auth (required) ---
# Secret used to sign this service's own HS256 JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- MinIO / S3 object storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sande
MINIO_SECRET_KEY=sande-secret
MINIO_BUCKET=product-images
MINIO_SECURE=false
# Public host the browser uses for image URLs (defaults to MINIO_ENDPOINT)
MINIO_PUBLIC_ENDPOINT=localhost:9000

# --- Bootstrap admin (python -m app.seed_auth) ---
ADMIN_EMAIL=admin@sande.local
ADMIN_PASSWORD=admin1234

# --- Payment gateway (Zarinpal) ---
# Sandbox merchant ID is the well-known test value; replace with your real merchant id in production.
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true

# --- Public URL of this backend (used to build the payment callback URL) ---
PUBLIC_BASE_URL=http://localhost:8000

# --- Frontend URL (payment callback redirects the shopper back here; also CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Shipping rules (mirror of the frontend cart logic, tomans) ---
SHIPPING_FLAT_FEE=89000
FREE_SHIPPING_THRESHOLD=2000000

# --- Notification providers (B2.1, decision D2) ---------------------------------
# All optional. Empty = the channel is unconfigured: no SMS/email is sent and the
# in-app notifications keep working. An admin must ALSO switch the channel on in
# /admin/settings before anything is sent. Never commit real values.
# SMS — Kavenegar (API key from the Kavenegar panel; sender = dedicated line, optional)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Email — SMTP (STARTTLS on 587 by default; set SMTP_SSL=true for implicit TLS on 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Password reset (F2.3) --------------------------------------------------------
# The reset email is sent through the email channel above (switch on in
# /admin/settings AND SMTP configured). Only a hash of each link is stored.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=3
