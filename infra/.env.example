# SÂNDÉ local stack — copy to infra/.env and fill in.
#   cp infra/.env.example infra/.env

# --- Auth (required) ---------------------------------------------------------
# Signs the backend's own JWTs. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Bootstrap admin (created by the db-init job via python -m app.seed_auth) -
ADMIN_EMAIL=admin@sande.local
ADMIN_PASSWORD=admin1234

# --- Payment gateway (Zarinpal) ----------------------------------------------
# Zero UUID = simulation mode (no real gateway calls)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true

# --- Local Postgres (backend's database) --------------------------------------
# Auto-built into DATABASE_URL for the backend container; exposed on localhost
# with POSTGRES_PORT for psql/GUI access.
POSTGRES_USER=sande
POSTGRES_PASSWORD=sande
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Optional full override (keep the +asyncpg driver):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres

# --- MinIO (S3-compatible storage — product images live here) -----------------
MINIO_ROOT_USER=sande
MINIO_ROOT_PASSWORD=sande-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Ports / URLs --------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Where the browser reaches the backend API:
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000
# Where the browser reaches MinIO (image URLs):
VITE_MINIO_URL=http://localhost:9000
# Same host, as the backend sees it: presigned URLs are signed for this host, so it
# must match what the browser sends (not the in-cluster `minio:9000`).
MINIO_PUBLIC_ENDPOINT=localhost:9000
# Backend->frontend redirect after payment; keep in sync with FRONTEND_PORT
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# --- Shipping rules (mirror of the frontend cart logic, tomans) ----------------
SHIPPING_FLAT_FEE=89000
FREE_SHIPPING_THRESHOLD=2000000

# --- Client IP + contact-form abuse guard (B3.11) -------------------------------
# Comma-separated IPs/CIDRs of reverse proxies in front of the backend whose
# X-Forwarded-For may be believed. Leave empty when browsers reach the backend
# directly (the default compose setup): the header is then client-controlled and
# is ignored, and the socket peer is the client IP (audit trail + throttle).
TRUSTED_PROXIES=
# POST /contact: attempts per IP per sliding window (decision D1: 5 per 10 min)
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600

# --- Notification providers (B2.1, decision D2) ---------------------------------
# All optional. Empty = the channel is unconfigured: no SMS/email is sent and the
# in-app notifications keep working. An admin must ALSO switch the channel on in
# /admin/settings before anything is sent. Never commit real values.
# SMS — Kavenegar (API key from the Kavenegar panel; sender = dedicated line, optional)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Email — SMTP (STARTTLS on 587 by default; set SMTP_SSL=true for implicit TLS on 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Password reset (F2.3) --------------------------------------------------------
# The reset email is sent through the email channel above (switch on in
# /admin/settings AND SMTP configured). Only a hash of each link is stored.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=3
